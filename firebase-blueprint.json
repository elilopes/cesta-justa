{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Supermercado ou mercadinho cadastrado pela comunidade",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "type": { "type": "string", "enum": ["supermercado", "mercadinho", "atacarejo", "hortifruti"] },
        "street": { "type": "string", "minLength": 3, "maxLength": 120 },
        "neighborhood": { "type": "string", "minLength": 2, "maxLength": 80 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "hours": { "type": "string", "maxLength": 60 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "street", "neighborhood", "city", "lat", "lng", "hours", "createdBy", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Produto da cesta básica ou item de mercado monitorado",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": { "type": "string", "enum": ["grãos", "laticínios", "carnes", "hortifruti", "padaria", "limpeza", "bebidas", "óleo_açúcar"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "brand": { "type": "string", "maxLength": 60 },
        "isEssentialBasket": { "type": "boolean" },
        "referencePrice": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "unit", "brand", "isEssentialBasket", "referencePrice", "createdBy", "createdAt"]
    },
    "PriceEntry": {
      "title": "PriceEntry",
      "description": "Registro colaborativo de preço em tempo real por estabelecimento",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "price": { "type": "number" },
        "isPromo": { "type": "boolean" },
        "promoLabel": { "type": "string", "maxLength": 60 },
        "inStock": { "type": "boolean" },
        "reportedBy": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "storeId", "price", "isPromo", "promoLabel", "inStock", "reportedBy", "reporterName", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil público básico do usuário sem PII",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "neighborhood": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "city", "neighborhood", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "PII isolada do usuário",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "updatedAt"]
    },
    "ShoppingList": {
      "title": "ShoppingList",
      "description": "Lista de compras inteligente sincronizada na nuvem",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "neighborhoodFilter": { "type": "string", "maxLength": 80 },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "neighborhoodFilter", "items", "createdAt", "updatedAt"]
    },
    "FavoriteAlert": {
      "title": "FavoriteAlert",
      "description": "Produto favoritado com regras de notificação de menor preço e promoção",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "desiredMaxPrice": { "type": "number" },
        "notifyOnPromo": { "type": "boolean" },
        "notifyOnLowest": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "productId", "desiredMaxPrice", "notifyOnPromo", "notifyOnLowest", "createdAt", "updatedAt"]
    },
    "SavingsLog": {
      "title": "SavingsLog",
      "description": "Registro de economia mensal ao escolher estabelecimentos mais baratos",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "monthKey": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "paidTotal": { "type": "number" },
        "averageMarketTotal": { "type": "number" },
        "savedAmount": { "type": "number" },
        "itemsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "monthKey", "storeId", "storeName", "paidTotal", "averageMarketTotal", "savedAmount", "itemsCount", "createdAt"]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Catálogo de supermercados e mercadinhos"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catálogo de produtos da cesta básica"
    },
    "/priceEntries/{entryId}": {
      "schema": { "$ref": "#/entities/PriceEntry" },
      "description": "Preços colaborativos em tempo real"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfil do usuário"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Informações privadas (PII) do usuário"
    },
    "/shoppingLists/{listId}": {
      "schema": { "$ref": "#/entities/ShoppingList" },
      "description": "Listas de compras sincronizadas na nuvem"
    },
    "/favorites/{favId}": {
      "schema": { "$ref": "#/entities/FavoriteAlert" },
      "description": "Favoritos e metas de menor preço"
    },
    "/savingsLogs/{logId}": {
      "schema": { "$ref": "#/entities/SavingsLog" },
      "description": "Histórico de economia mensal"
    }
  }
}
